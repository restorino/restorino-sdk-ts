{
  "name": "@restorino/sdk",
  "version": "0.0.1",
  "description": "TypeScript SDK for Restorino Storefront, Vitrine and Customer Dashboard (Lovable.dev & React ready)",
  "main": "dist/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/restorino/restorino-sdk-ts.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "dist-bundle",
    "examples",
    "README.md",
    "LOVABLE_PROMPT.md",
    "LOVABLE_1SHOT_PROMPT.txt",
    "prompt.txt",
    "llms.txt",
    "CHANGELOG.md",
    ".env.example",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": "^22.23.4 || ^24.22.3 || >=26.12.1"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "pnpm run clean && tsc && tsc -p tsconfig.esm.json && node scripts/build-esm.mjs && pnpm run bundle:single",
    "bundle:single": "node scripts/bundle-single.mjs",
    "typecheck": "tsc --noEmit --noUnusedLocals --noUnusedParameters -p tsconfig.json",
    "typecheck:examples": "tsc -p examples/vanilla/tsconfig.json",
    "contract:snapshot": "node scripts/contract-snapshot.mjs",
    "test": "pnpm run build && node --test \"test/**/*.test.mjs\"",
    "prepack": "pnpm run build",
    "prepublishOnly": "pnpm run test"
  },
  "keywords": [
    "restorino",
    "restaurant",
    "restaurant-saas",
    "restaurant-ordering",
    "food-delivery",
    "online-ordering",
    "qr-code-menu",
    "digital-menu",
    "loyalty-program",
    "storefront",
    "ecommerce",
    "lovable",
    "sdk",
    "typescript",
    "react",
    "nextjs",
    "gemini-live",
    "ai-agent"
  ],
  "author": "Restorino Team <contact@restorino.com>",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.3"
  }
}
