# ==============================================================================
# 🍽️ Restorino Storefront / Vitrine SDK Environment Configuration
# ==============================================================================

# URL de base de l'API Restorino (Spring Boot backend)
# Local: http://localhost:8080 | Production: https://api.votre-restaurant.com
VITE_RESTORINO_API_URL=http://localhost:8080

# Identifiant unique UUID du restaurant (Domain scope) - Exemple démo: 267023c6-e046-4785-9fa2-393938d2294b
VITE_RESTAURANT_ID=267023c6-e046-4785-9fa2-393938d2294b

# Identifiant unique UUID du tenant SaaS (Data boundary isolation) - Exemple démo: 1765a2e0-f0c1-4303-9888-b1c29d0f8b91
VITE_TENANT_ID=1765a2e0-f0c1-4303-9888-b1c29d0f8b91

# Ce SDK est storefront-only : il n'expose aucune surface d'administration
# et n'accepte aucune clé API. Le seul identifiant est le cookie client
# (HttpOnly), posé par le backend lors du login.

# (Optionnel) Pour Next.js, les variables NEXT_PUBLIC_* ne doivent contenir
# aucun secret Vitrine.
# NEXT_PUBLIC_RESTORINO_API_URL=http://localhost:8080
# NEXT_PUBLIC_RESTAURANT_ID=00000000-0000-0000-0000-000000000001
# NEXT_PUBLIC_TENANT_ID=00000000-0000-0000-0000-000000000001
